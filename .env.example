# ============================================================
# Financial Jarvis - Konfigurationsdatei
# ============================================================
# 1. Kopiere diese Datei: copy .env.example .env
# 2. Trage deine echten API-Keys in die .env ein
# ACHTUNG: .env niemals ins Internet hochladen!

# --- OpenAI (Das KI-Gehirn) ---
# Key holen auf: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-DEIN_KEY_HIER

# --- Telegram Bot (Push-Nachrichten aufs Handy) ---
# Anleitung: Schreibe @BotFather auf Telegram -> /newbot
TELEGRAM_BOT_TOKEN=1234567890:ABCdef-DEIN_BOT_TOKEN
# Deine Chat-ID: Schreibe @userinfobot auf Telegram
TELEGRAM_CHAT_ID=DEINE_CHAT_ID

# --- Finnhub (Kostenlose Echtzeit-News & Kurse) ---
# Gratis-Key auf: https://finnhub.io
FINNHUB_API_KEY=DEIN_FINNHUB_KEY

# --- NewsAPI (Globale Nachrichten) ---
# Gratis-Key auf: https://newsapi.org
NEWSAPI_KEY=DEIN_NEWSAPI_KEY

# --- Alpha Vantage (Detaillierte Aktiendaten) ---
# Gratis-Key auf: https://alphavantage.co
ALPHAVANTAGE_KEY=DEIN_ALPHAVANTAGE_KEY

# --- Deine Watchlist (Komma-getrennt) ---
WATCHLIST_STOCKS=AAPL,NVDA,TSLA,MSFT,AMZN,SPY
WATCHLIST_CRYPTO=BTC-USD,ETH-USD,SOL-USD

# --- Alarmschwelle: Bei X% Kursveraenderung wird Alarm ausgeloest ---
PRICE_CHANGE_THRESHOLD=3.0

# --- Sprache der KI-Antworten ---
AI_LANGUAGE=Deutsch
